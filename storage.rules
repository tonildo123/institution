rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function sender() {
      let user = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      return user.isEnabled == true && user.role in ['admin', 'preceptor', 'equipo directivo', 'representante legal'];
    }
    match /communication-images/{uid}/{imageId} {
      allow read: if request.auth != null && request.auth.uid == uid && sender();
      allow create, update: if request.auth != null && request.auth.uid == uid && sender()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == uid && sender();
    }
  }
}
