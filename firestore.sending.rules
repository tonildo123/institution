rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function enabled() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isEnabled == true;
    }
    function manager() {
      return enabled() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        in ['admin', 'equipo directivo', 'representante legal'];
    }
    function participant() {
      return enabled() && (resource.data.get('sentBy', '') == request.auth.uid ||
        request.auth.uid in resource.data.get('targetUserIds', []));
    }
    match /communications/{messageId} {
      // Transición: la privacidad de lectura se activa tras preparar las cuentas familiares.
      allow read: if true;
      // Los envíos se crean exclusivamente en Cloud Functions.
      allow create: if false;
      allow delete: if (manager() && participant()) || (enabled() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'preceptor' &&
        resource.data.get('sentBy', '') == request.auth.uid);
      allow update: if manager() && participant() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'body', 'updatedAt']);
    }
    match /classroom/{messageId} {
      // Transición: la privacidad de lectura se activa tras preparar las cuentas familiares.
      allow read: if true;
      // Los envíos se crean exclusivamente en Cloud Functions.
      allow create: if false;
      allow delete: if (manager() && participant()) || (enabled() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'preceptor' &&
        resource.data.get('sentBy', '') == request.auth.uid);
      allow update: if manager() && participant() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'body', 'updatedAt']);
    }
    match /classroom/{taskId}/submissions/{studentId} {
      // Cada alumno lee su entrega; administración y la docente que publicó la tarea leen todas.
      allow read: if request.auth != null && (request.auth.uid == studentId || manager() ||
        get(/databases/$(database)/documents/classroom/$(taskId)).data.sentBy == request.auth.uid);
      // Las entregas se crean exclusivamente en Cloud Functions (submitClassroomTask).
      allow create, update, delete: if false;
    }
    match /users/{userId} {
      // Se conserva la búsqueda de perfiles previa al login por email/DNI.
      // Las contraseñas se almacenan exclusivamente en Firebase Auth.
      allow read: if true;
      allow delete: if manager();
      allow create: if manager() || (request.auth != null && request.auth.uid == userId &&
        request.resource.data.role == 'user' && !request.resource.data.keys().hasAny(['password']));
      allow update: if manager() || (enabled() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'pushTokens', 'updatedAt']));
    }
    match /salas/{level} {
      allow read: if enabled();
      allow write: if manager();
      match /cursos/{cursoId} {
        allow read: if enabled();
        allow write: if manager();
      }
    }
  }
}
